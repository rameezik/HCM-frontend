# Server-side Express API origin, read at runtime. Browser requests and downloads
# stay same-origin under /api so HttpOnly sessions do not need cross-site cookies.
API_INTERNAL_URL=http://127.0.0.1:4000
# Optional compatibility alias; used only when API_INTERNAL_URL is unset.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Backend FRONTEND_URL must include the actual frontend origin.
